# Optional: leave blank until you connect Gemini. Never use a VITE_ prefix for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Empty uses local persistent PostgreSQL (PGlite). Set an external PostgreSQL URL for hosting.
DATABASE_URL=
LOCAL_DB_PATH=.local/postgres
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set 1 only behind one trusted reverse proxy, e.g. a managed hosting load balancer.
TRUST_PROXY_HOPS=0
# Required only for actual password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional licensed Times New Roman .ttf; otherwise bundled DejaVu Serif is used in PDF.
PDF_FONT_PATH=
